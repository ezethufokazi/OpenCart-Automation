<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="OpenCart Grid Suite">

    <listeners>
        <listener class-name="utilities.ExtentReportManager"/>
    </listeners>

    <test name="OpenCart Docker Grid Tests">
        <parameter name="os" value="linux"/>
        <parameter name="browser" value="chrome"/>

        <classes>
            <class name="testCases.TC001_AccRegTest"/>
            <class name="testCases.TC002_LoginTest"/>
            <class name="testCases.TC003_LoginDataDriven"/>
            <class name="testCases.TC004_PDPTest"/>
            <class name="testCases.TC005_VerifyCartPage"/>
            <class name="testCases.TC006_GuestCheckoutTest"/>
            <class name="testCases.TC007_LoggedInUserCheckout"/>
            <class name="testCases.TC007b_LoggedInNewAddress"/>
            <class name="testCases.TC008_RegisterCheckout"/>
        </classes>
    </test>

</suite>